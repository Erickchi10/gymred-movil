  "info": {
    "title": "Gymred API",
    "description": "API de la plataforma de gimnasios Gymred. La usan el panel web, el lector de acceso y la app movil.",
    "version": "1.0",
    "contact": {

    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "Autenticacion de duenos y clientes"
    },
    {
      "name": "gimnasios",
      "description": "Panel web: datos, horarios, fotos, servicios y amenidades"
    },
    {
      "name": "precios",
      "description": "Panel web: precios propios del gimnasio"
    },
    {
      "name": "contrato",
      "description": "Panel web: plan Gymred, liquidaciones y baja"
    },
    {
      "name": "accesos",
      "description": "Panel web: dashboard, historial y reportes"
    },
    {
      "name": "pantalla",
      "description": "Pantalla de acceso: genera el QR que escanea el socio"
    },
    {
      "name": "inventario",
      "description": "Panel web: equipo y actividades del gimnasio"
    },
    {
      "name": "incidencias",
      "description": "Panel web: reportes de mantenimiento"
    },
    {
      "name": "configuracion",
      "description": "Panel web: preferencias del panel y del lector"
    },
    {
      "name": "movil",
      "description": "Endpoints de la app movil (clientes)"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ricardo@ironhouse.mx"
          },
          "password": {
            "type": "string",
            "example": "Gymred123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RegistroDuenoDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Ana Lopez"
          },
          "email": {
            "type": "string",
            "example": "ana@migym.mx"
          },
          "password": {
            "type": "string",
            "example": "Gymred123"
          },
          "telefono": {
            "type": "string"
          },
          "nombreGimnasio": {
            "type": "string",
            "example": "Gimnasio Fuerza"
          },
          "calle": {
            "type": "string"
          },
          "colonia": {
            "type": "string"
          },
          "ciudad": {
            "type": "string",
            "example": "Merida"
          },
          "categoria": {
            "type": "string",
            "example": "gimnasio"
          }
        },
        "required": [
          "nombre",
          "email",
          "password",
          "nombreGimnasio"
        ]
      },
      "RegistroClienteDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "telefono": {
            "type": "string"
          }
        },
        "required": [
          "nombre",
          "email",
          "password"
        ]
      },
      "CambiarPasswordDto": {
        "type": "object",
        "properties": {
          "actual": {
            "type": "string"
          },
          "nueva": {
            "type": "string"
          }
        },
        "required": [
          "actual",
          "nueva"
        ]
      },
      "DatosGimnasioDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "calle": {
            "type": "string"
          },
          "colonia": {
            "type": "string"
          },
          "ciudad": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "codigoPostal": {
            "type": "string"
          },
          "telefono": {
            "type": "string"
          },
          "latitud": {
            "type": "number"
          },
          "longitud": {
            "type": "number"
          },
          "capacidadMaxima": {
            "type": "number"
          },
          "categoria": {
            "type": "string",
            "example": "gimnasio"
          }
        }
      },
      "HorarioDto": {
        "type": "object",
        "properties": {
          "diaSemana": {
            "type": "number",
            "example": 1,
            "description": "1 = lunes ... 7 = domingo"
          },
          "horaApertura": {
            "type": "string",
            "example": "06:00:00"
          },
          "horaCierre": {
            "type": "string",
            "example": "22:00:00"
          },
          "cerrado": {
            "type": "boolean"
          }
        },
        "required": [
          "diaSemana"
        ]
      },
      "HorariosDto": {
        "type": "object",
        "properties": {
          "horarios": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HorarioDto"
            }
          }
        },
        "required": [
          "horarios"
        ]
      },
      "FotoDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "/uploads/mi-foto.jpg"
          },
          "descripcion": {
            "type": "string"
          },
          "portada": {
            "type": "boolean"
          },
          "orden": {
            "type": "number"
          }
        },
        "required": [
          "url"
        ]
      },
      "ServicioDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Spinning"
          },
          "descripcion": {
            "type": "string"
          },
          "activo": {
            "type": "boolean"
          }
        },
        "required": [
          "nombre"
        ]
      },
      "AmenidadDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Regaderas"
          },
          "icono": {
            "type": "string",
            "example": "shower"
          }
        },
        "required": [
          "nombre"
        ]
      },
      "PrecioDto": {
        "type": "object",
        "properties": {
          "concepto": {
            "type": "string",
            "example": "mes",
            "enum": [
              "visita",
              "semana",
              "quincena",
              "mes",
              "anual"
            ]
          },
          "monto": {
            "type": "number",
            "example": 599
          },
          "activo": {
            "type": "boolean"
          }
        },
        "required": [
          "concepto",
          "monto"
        ]
      },
      "SolicitudPlanDto": {
        "type": "object",
        "properties": {
          "tipoSolicitado": {
            "type": "string",
            "example": "premium",
            "enum": [
              "basico",
              "premium",
              "elite"
            ]
          },
          "mensaje": {
            "type": "string",
            "example": "Queremos reportes avanzados."
          }
        },
        "required": [
          "tipoSolicitado"
        ]
      },
      "SolicitudBajaDto": {
        "type": "object",
        "properties": {
          "motivo": {
            "type": "string",
            "example": "Cierre temporal del gimnasio"
          },
          "comentario": {
            "type": "string"
          }
        },
        "required": [
          "motivo"
        ]
      },
      "ContratarPlanDto": {
        "type": "object",
        "properties": {
          "idPlan": {
            "type": "number",
            "example": 2,
            "description": "Id del plan de la plataforma"
          },
          "metodo": {
            "type": "string",
            "example": "tarjeta"
          }
        },
        "required": [
          "idPlan"
        ]
      },
      "EntrarDto": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "example": "FP.FP-LEC-0001.9A3C7E1B5D02",
            "description": "El codigo que muestra la pantalla de la entrada"
          }
        },
        "required": [
          "codigo"
        ]
      },
      "ResenaDto": {
        "type": "object",
        "properties": {
          "calificacion": {
            "type": "number",
            "example": 5
          },
          "comentario": {
            "type": "string"
          }
        },
        "required": [
          "calificacion"
        ]
      },
      "CrearEquipoDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Prensa de piernas"
          },
          "categoria": {
            "type": "string",
            "example": "maquinas",
            "enum": [
              "peso_libre",
              "maquinas",
              "cardio",
              "funcional",
              "clases",
              "otro"
            ]
          },
          "descripcion": {
            "type": "string"
          },
          "cantidad": {
            "type": "number",
            "example": 2
          },
          "situacion": {
            "type": "string",
            "enum": [
              "disponible",
              "fuera_de_servicio"
            ]
          }
        },
        "required": [
          "nombre",
          "categoria"
        ]
      },
      "ActualizarEquipoDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "categoria": {
            "type": "string",
            "enum": [
              "peso_libre",
              "maquinas",
              "cardio",
              "funcional",
              "clases",
              "otro"
            ]
          },
          "descripcion": {
            "type": "string"
          },
          "cantidad": {
            "type": "number"
          },
          "situacion": {
            "type": "string",
            "enum": [
              "disponible",
              "fuera_de_servicio"
            ]
          }
        }
      },
      "CrearIncidenciaDto": {
        "type": "object",
        "properties": {
          "equipo": {
            "type": "string",
            "example": "Cinta de correr #2"
          },
          "titulo": {
            "type": "string",
            "example": "La banda se traba al subir la velocidad"
          },
          "descripcion": {
            "type": "string"
          },
          "prioridad": {
            "type": "string",
            "enum": [
              "baja",
              "media",
              "alta"
            ]
          }
        },
        "required": [
          "equipo",
          "titulo"
        ]
      },
      "ActualizarIncidenciaDto": {
        "type": "object",
        "properties": {
          "equipo": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "prioridad": {
            "type": "string",
            "enum": [
              "baja",
              "media",
              "alta"
            ]
          },
          "situacion": {
            "type": "string",
            "enum": [
              "pendiente",
              "en_progreso",
              "resuelto"
            ]
          }
        }
      },
      "ConfiguracionDto": {
        "type": "object",
        "properties": {
          "tema": {
            "type": "string",
            "enum": [
              "claro",
              "oscuro"
            ]
          },
          "colorAcento": {
            "type": "string",
            "enum": [
              "naranja",
              "azul",
              "verde",
              "morado"
            ]
          },
          "modoValidacion": {
            "type": "string",
            "enum": [
              "en_linea",
              "tolerancia_sin_conexion"
            ]
          },
          "toleranciaSegundos": {
            "type": "number",
            "example": 300,
            "description": "Cuánto vive el código QR, en segundos"
          },
          "avisarPorCorreo": {
            "type": "boolean"
          },
          "avisarAccesosDenegados": {
            "type": "boolean"
          },
          "avisarIncidencias": {
            "type": "boolean"
          }
        }
      }
    }
  }
}