    "/api/accesos/{gymId}/historial": {
      "get": {
        "operationId": "AccessController_historial",
        "summary": "Historial de accesos con filtros",
        "parameters": [
          {
            "name": "gymId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "desde",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-09-01",
              "type": "string"
            }
          },
          {
            "name": "hasta",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-09-14",
              "type": "string"
            }
          },
          {
            "name": "resultado",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "permitido",
                "denegado"
              ],
              "type": "string"
            }
          },
          {
            "name": "buscar",
            "required": false,
            "in": "query",
            "description": "Busca por nombre de cliente o codigo leido",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pagina",
            "required": false,
            "in": "query",
            "schema": {
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "porPagina",
            "required": false,
            "in": "query",
            "schema": {
              "example": 15,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "accesos"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
